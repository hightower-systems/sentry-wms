{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentry-wms.example/events/inventorytransfer.completed/1.json",
  "title": "inventorytransfer.completed v1",
  "description": "An inventory transfer has completed. Emitted from api/routes/transfers.py::move (bin-to-bin) and api/routes/admin/admin_transfer_orders.py::approve_transfer_order_approval (inter-warehouse approval). The entity-prefixed name connectors filter on; replaces the retired transfer.completed/1 event. Aggregate: inventory_transfer.",
  "type": "object",
  "required": [
    "transfer_external_id",
    "from_warehouse_id",
    "to_warehouse_id",
    "lines",
    "completed_at"
  ],
  "additionalProperties": false,
  "properties": {
    "transfer_external_id": {
      "type": "string",
      "format": "uuid"
    },
    "from_warehouse_id": {
      "type": "integer",
      "minimum": 1
    },
    "to_warehouse_id": {
      "type": "integer",
      "minimum": 1
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "item_external_id",
          "quantity"
        ],
        "additionalProperties": false,
        "properties": {
          "item_external_id": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "to_line_id": {
            "type": "integer",
            "minimum": 1
          },
          "source_bin_id": {
            "type": "integer",
            "minimum": 1
          },
          "destination_bin_id": {
            "type": "integer",
            "minimum": 1
          },
          "lot_number": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 50
          },
          "serial_number": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          }
        }
      }
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
