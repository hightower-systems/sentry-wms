# Docker
pgdata/
# docker-compose.override.yml is fork-local. Our avid-overhaul-mk1 dev
# loop needs the api build context to be the repo root so api/Dockerfile
# can COPY both api/ and db/mappings/ (upstream commit c579092 changed
# the Dockerfile but never updated docker-compose.yml to match). The
# override file lives outside source control so upstream's tracked
# docker-compose.yml stays untouched and our fork-specific
# accommodation stays out of merges.
docker-compose.override.yml

# Build outputs
dist/
build/
*.egg

# v1.4.2 #73 artifact: api/Dockerfile bakes this at image build time
# (RUN grep ... > /app/BUILD_VERSION) for the check_build_version()
# startup guard. It should never be committed -- the file is baked
# per-image and can leak onto the host via the dev bind mount. If it
# does leak with a stale version, the guard sys.exit(2)s the dev
# container on every restart after a version bump.
api/BUILD_VERSION

# Expo / React Native
mobile/.expo/web/
mobile/android/
mobile/ios/
site/

# Proxy
proxy/certs/
proxy/certs/*.pem
