<view class="page">
  <view class="hero">
    <view class="row">
      <view>
        <view class="chip">{{session.user.role}}</view>
        <view class="hero-title">{{session.user.full_name || session.user.username}}</view>
      </view>
      <button class="hero-logout" bindtap="logout">退出</button>
    </view>
    <view class="hero-meta">
      当前仓库：{{warehouseName || warehouseId || '未选择'}}
    </view>
  </view>

  <view class="card" wx:if="{{warehouses.length > 1}}">
    <view class="label">作业仓库</view>
    <picker
      mode="selector"
      range="{{warehouses}}"
      range-key="warehouse_name"
      bindchange="onWarehouseChange"
    >
      <view class="picker-value">
        {{warehouseName || '选择仓库'}} <text class="muted">›</text>
      </view>
    </picker>
  </view>

  <view class="section-title">现场作业</view>
  <view class="work-grid">
    <view class="work-card receive-card" bindtap="openReceive">
      <view class="work-kicker">INBOUND</view>
      <view class="work-title">收货任务</view>
      <view class="work-desc">到货清单、逐托拍照识别与实收入库</view>
      <view class="work-arrow">→</view>
    </view>
    <view class="work-card outbound-card" bindtap="openOutbound">
      <view class="work-kicker">OUTBOUND</view>
      <view class="work-title">出库与装车</view>
      <view class="work-desc">整票多吊牌核验、库存扣减与整单装车</view>
      <view class="work-arrow">→</view>
    </view>
  </view>

  <view class="card info-card">
    <view class="title">操作边界</view>
    <view class="subtitle">
      收货人、出库人和装车人自动取当前登录账号；区域、票货数量和仓库权限均由服务端校验。
    </view>
  </view>
</view>
